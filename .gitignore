# Build-time Node runtime cache used by packaging scripts.
vendor/node/

# Windows process guard build outputs. Detours sources are an external
# checkout (not a git submodule) so `uv sync` / pip install never hits GitHub.
agent_shield/native/windows-process-guard/build/
agent_shield/native/windows-process-guard/third_party/detours/
agent_shield/native/windows-process-guard/python/src/agent_security_windows_process_guard/bin/win_amd64/*
!agent_shield/native/windows-process-guard/python/src/agent_security_windows_process_guard/bin/win_amd64/.gitkeep
