+    if backend is None:
+        return
+    close = getattr(backend, "close", None)
+    if close is None:
+        return
+    try:
+        loop = asyncio.get_running_loop()
+    except RuntimeError:
+        # 无运行中事件循环(理论不可达: 调用点均处于循环线程同步上下文):
+        # 放弃后台关闭, 资源随进程退出由 OS 回收
