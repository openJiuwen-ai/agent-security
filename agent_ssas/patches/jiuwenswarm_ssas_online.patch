+  # HTTP 模式配置 (默认 mode=inprocess 不启用; 切换 mode=http 时需显式取消注释并配置,
+  # 注意: http_host 未配置时配置类默认为 0.0.0.0(监听全部网卡), 启用 http 模式前
+  # 必须显式配置 127.0.0.1 或内网地址, 并同时配置 http_token, 避免无鉴权端点对外暴露)
+  # http_endpoint: "http://127.0.0.1:8443"
+  # http_timeout: 5.0
+  # http_token:
+  # http_host: "127.0.0.1"
+  # http_port: 8443
+  # 存储配置 (遵循 JIUWENSWARM_HOME 约定; ssas_home 留空字符串时按
+  # SSAS_HOME -> JIUWENSWARM_DATA_DIR -> JIUWENSWARM_HOME -> ~/.jiuwenswarm 顺序自动解析)
+  ssas_home: ""
+  storage_backend: sqlite
+  event_ttl_days: 30
+  alert_ttl_days: 90
+  # Rail 配置 (rail_priority 生效于 agent-core 回调链排序, higher=first;
+  # 默认 80, 低于 PermissionInterruptRail 的 90)
+  rail_priority: 80
+  enable_exception_hooks: true
+  # 风险报告阈值: safe / low / medium / high / critical
+  risk_report_threshold: low
+  # auth 模式超时 (秒)
+  auth_timeout: 2.0
+  # AgentSSASSecurityRail 决策策略:
+  # - observe_only: 全部放行 (仅感知)
+  # - active_protection: 按风险等级处理 (critical->阻断, high/medium/low->告警)
+  # 策略定义在 AgentSSAS 的 decision_policies.yaml 中
+  decision_policy: observe_only
+  # 检测模块配置覆盖 (可覆盖 module.yaml 的 enabled 字段)
+  modules:
+    # test_detection 默认 disabled, 测试时设为 true 启用
+    test_detection:
+      enabled: false
+
